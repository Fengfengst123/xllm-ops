 """

 import ctypes
+import logging
 import os
 from typing import Any, Dict, List, Union


+# --- A5 GammaAddRmsNorm custom-op-api fallback (venv-local ATK compat patch) ---
+# Only these two symbols are allowed to fall back to GAMMA_OPAPI_LIB. Both must
+# resolve from the SAME custom-library handle. Do not route any other ACLNN
+# symbol to the custom library.
+_GAMMA_FALLBACK_SYMBOLS = frozenset({
+    "aclnnGammaAddRmsNormGetWorkspaceSize",
+    "aclnnGammaAddRmsNorm",
+})
+_GAMMA_CUSTOM_LIB_HANDLE = None  # module-level cache: single CDLL, never re-dlopen
+_GAMMA_CUSTOM_LIB_PATH_LOGGED = False
+
+
+def _get_gamma_custom_lib():
+    """Load (once) and cache the custom op-api lib pointed to by GAMMA_OPAPI_LIB.
+
+    Uses RTLD_GLOBAL so its symbols are visible to dependent lookups. Returns the
+    cached CDLL handle, or None if GAMMA_OPAPI_LIB is unset / file missing.
+    """
+    global _GAMMA_CUSTOM_LIB_HANDLE, _GAMMA_CUSTOM_LIB_PATH_LOGGED
+    if _GAMMA_CUSTOM_LIB_HANDLE is not None:
+        return _GAMMA_CUSTOM_LIB_HANDLE
+
+    lib_path = os.environ.get("GAMMA_OPAPI_LIB")
+    if not lib_path or not os.path.exists(lib_path):
+        return None
+
+    # Resolve to absolute + realpath once for the log (point 5: prove it is the
+    # from-scratch built/installed lib, not CANN libopapi.so / old build / other user).
+    abs_path = os.path.abspath(lib_path)
+    real_path = os.path.realpath(abs_path)
+    if not _GAMMA_CUSTOM_LIB_PATH_LOGGED:
+        logging.getLogger("atk").info(
+            "[GAMMA_OPAPI_FALLBACK] binding aclnnGammaAddRmsNorm[GetWorkspaceSize] "
+            "from custom lib: GAMMA_OPAPI_LIB=%s abs=%s realpath=%s",
+            lib_path, abs_path, real_path,
+        )
+        _GAMMA_CUSTOM_LIB_PATH_LOGGED = True
+
+    _GAMMA_CUSTOM_LIB_HANDLE = ctypes.CDLL(real_path, mode=ctypes.RTLD_GLOBAL)
+    return _GAMMA_CUSTOM_LIB_HANDLE
+
+
 class LibManager:
