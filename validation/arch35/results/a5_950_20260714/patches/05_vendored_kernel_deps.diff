+    DataCopyParams copyParams;
+    copyParams.blockLen = numCol * sizeof(T);
+    copyParams.blockCount = numRow;
+    DataCopyPadParams padParams;
+    DataCopyPad(dstTensor, srcTensor, copyParams, padParams);
+#endif
